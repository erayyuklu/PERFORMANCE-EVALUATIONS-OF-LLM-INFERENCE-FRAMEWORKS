# --- GAIA Evaluation Configuration ---

# Agent endpoint is discovered automatically via kubectl.
# Override with --agent-url CLI flag if needed.

# Kubernetes
AGENT_K8S_NAMESPACE=agent
AGENT_K8S_SERVICE=agent-service

# --- Output Directory Formatting ---
# Convention: {OUTPUT_DIR}/{AGENT_MODE}/{MODEL_FAMILY}/{QUANTIZATION}/gaia
MODEL_FAMILY=gemini-3-flash
QUANTIZATION=no-quantization
AGENT_MODE=planner-only_gemini3-flash

# HuggingFace dataset
GAIA_DATASET=gaia-benchmark/GAIA
GAIA_CONFIG=2023_all
GAIA_SPLIT=validation

# Filter by difficulty levels (comma-separated: 1,2,3)
GAIA_LEVELS=1

# Limit number of questions (0 = run all)
LIMIT=0

# Output directory base (relative to this file)
OUTPUT_DIR=../agent-results

# Request settings
REQUEST_TIMEOUT=600
MAX_CONCURRENT=4